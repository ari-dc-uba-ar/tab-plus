{
  "name": "tab-plus",
  "description": "parser and generator for the .tab file format used by backend-plus",
  "version": "0.1.9",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "repository": "ari-dc-uba-ar/tab-plus",
  "main": "dist/tab-plus.js",
  "types": "dist/tab-plus.d.ts",
  "bin": {
    "tab-plus": "bin/tab-plus.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    }
  ],
  "overrides": {
    "browserslist": ">=4.28.7",
    "diff": ">=8.0.2",
    "js-yaml": ">=5.4.1",
    "serialize-javascript": ">=7.0.0",
    "uuid": ">=14.0.0"
  },
  "dependencies": {
    "cleye": "^2.6.0"
  },
  "devDependencies": {
    "@types/expect.js": "^0.3.32",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@types/parallel-transform": "^1.1.4",
    "expect.js": "^0.3.1",
    "line-splitter": "^0.8.8",
    "mocha": "^12.0.0",
    "multilang": "^1.2.5",
    "nyc": "^18.0.0",
    "parallel-transform": "^1.2.0",
    "qa-control": "^0.10.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "tsc -p src",
    "pretest": "npm run build",
    "test": "mocha --reporter spec --bail --check-leaks -r tsx/cjs --extensions ts test/test.ts test/sparse.ts test/auto-tab-plus.ts test/cli.ts",
    "pretest-ci": "npm run build",
    "test-ci": "nyc mocha --reporter spec --bail --check-leaks -r tsx/cjs --extensions ts test/test.ts test/sparse.ts test/auto-tab-plus.ts test/cli.ts",
    "docs": "multilang --check --verbose LEEME.md && multilang LEEME.md"
  },
  "qa-control": {
    "gha": "skip",
    "run-in": "both",
    "type": "lib",
    "silenced": [
      "first_lines_does_not_match_in_file_1",
      "eslint_warnings_in_file_1"
    ]
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ]
  }
}
